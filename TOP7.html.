<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>TOP7 BQM</title>
<style>
body {
 background:#050914;
 color:white;
 font-family:Arial;
 text-align:center;
 padding:30px 10px;
}
.panel {
 background:#0b1425;
 border:2px solid #164c91;
 border-radius:20px;
 padding:25px;
 max-width:350px;
 margin:auto;
}
h1 {color:#55aaff;font-size:38px}
button {
 background:#123d70;
 color:white;
 border:1px solid #398cff;
 border-radius:12px;
 padding:15px;
 width:100%;
 font-size:17px;
 margin:15px 0;
}
#status {color:#55aaff}
</style>
</head>
<body>
<div class="panel">
<h1>TOP7</h1>
<p>BQM FISHING</p>
<h3 id="status">AUTO FISH : OFF</h3>
<button onclick="toggle()">START AUTO FISH</button>
<p>FISHING CONTROL</p>
</div>
<script>
let active=false;
function toggle(){
 active=!active;
 document.getElementById("status").innerText=
 "AUTO FISH : "+(active?"ON":"OFF");
}
</script>
</body>
</html>
